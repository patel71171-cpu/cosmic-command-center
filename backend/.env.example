# SENTINEL backend configuration — copy to `.env` and edit for production.

# Database. The +psycopg2 driver is explicit because SQLAlchemy 2.1 no longer
# implies it for a bare postgresql:// URL. When Postgres is unreachable the
# backend falls back to SQLite (backend/sentinel.db) and logs a loud warning.
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@localhost:5432/sentinel

# Broker/backend for the Celery worker.
REDIS_URL=redis://localhost:6379/0

# JWT signing key. REQUIRED for production — generate with:
#   openssl rand -hex 32
# Leave unset to let the backend generate and persist its own key in
# backend/.jwt_secret (tokens then survive restarts, but a fresh key is minted
# per deployment, so set this explicitly across multiple nodes).
# JWT_SECRET=

# Comma-separated browser origins allowed by CORS. Not needed when the frontend
# is served from the same origin and proxies /api.
CORS_ORIGINS=http://localhost:3002,http://localhost:3000

# AI Copilot — the Ollama server the backend talks to.
#   Local run:   http://localhost:11434  (Ollama installed on this machine)
#   Docker:      http://ollama:11434     (the bundled compose service)
# A bare host:port is also accepted ("ollama:11434") and gets http:// prepended.
OLLAMA_HOST=http://localhost:11434

# Model to request. Must already be pulled on that server:
#   ollama pull qwen2.5vl:3b
# In Docker, the ollama-init service pulls it automatically on first start.
OLLAMA_MODEL=qwen2.5vl:3b

# How long to wait for a generation. Raise for slow CPU-only hosts.
OLLAMA_TIMEOUT_SECONDS=180

DEBUG=false

# Scan sandbox limits
SANDBOX_NETWORK=sentinel-sandbox
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_TIMEOUT_SECONDS=300

# Where signed evidence blobs are stored
EVIDENCE_STORAGE_PATH=./evidence_storage
