# SENTINEL backend configuration — copy to `.env` and edit for production.

# Database. When Postgres is unreachable the backend falls back to SQLite
# (backend/sentinel.db) so a single-node demo still boots.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# Broker/backend for the Celery worker.
REDIS_URL=redis://localhost:6379/0

# JWT signing key. REQUIRED for production — generate with:
#   openssl rand -hex 32
# Leave unset to let the backend generate and persist its own key in
# backend/.jwt_secret (tokens then survive restarts, but a fresh key is minted
# per deployment, so set this explicitly across multiple nodes).
# JWT_SECRET=

# Comma-separated browser origins allowed by CORS. Not needed when the frontend
# is served from the same origin and proxies /api.
CORS_ORIGINS=http://localhost:3002,http://localhost:3000

# Local Ollama model used by the AI Copilot (must be running on this machine).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

DEBUG=false

# --- Google sign-in (optional) -------------------------------------------
# Leave both blank to disable Google sign-in; the login page then shows the
# Google button as unavailable instead of failing. To enable it:
#
#   1. Google Cloud Console -> create/select a project
#   2. Enable the "Google Identity Platform" (APIs & Services -> Library)
#   3. Credentials -> Create Credentials -> OAuth client ID -> Web application
#   4. Add the redirect URI below EXACTLY as written (no trailing slash)
#   5. Paste the Client ID and Client Secret here and restart the backend
#
# The account is created automatically on first sign-in with the `viewer`
# role. Promote it in the Users table if more access is needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Where the browser returns after Google authenticates. Must match the
# frontend origin, otherwise the one-time code lands somewhere unreachable.
FRONTEND_URL=http://localhost:3002

# Scan sandbox limits
SANDBOX_NETWORK=sentinel-sandbox
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_TIMEOUT_SECONDS=300

# Where signed evidence blobs are stored
EVIDENCE_STORAGE_PATH=./evidence_storage
